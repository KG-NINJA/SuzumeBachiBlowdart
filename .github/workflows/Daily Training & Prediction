name: Daily Training & Prediction

on:
  # スケジュール実行（毎営業日）
  schedule:
    - cron: '0 8 * * 1-5'   # 08:00 JST (UTC-9, so 23:00 UTC previous day)
    - cron: '0 17 * * 1-5'  # 17:00 JST (UTC-9, so 08:00 UTC)
  
  # 手動実行用
  workflow_dispatch:
  
  # コミット時
  push:
    branches: [ main ]

jobs:
  predict:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
    
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.11'
    
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
    
    - name: Run predictions
      run: python simple_daily_prediction.py
      env:
        POLYGON_API_KEY: ${{ secrets.POLYGON_API_KEY }}
        ALPHA_VANTAGE_KEY: ${{ secrets.ALPHA_VANTAGE_KEY }}
        TIINGO_API_KEY: ${{ secrets.TIINGO_API_KEY }}
    
    - name: Commit & Push results
      run: |
        git config --local user.email "actions@github.com"
        git config --local user.name "github-actions[bot]"
        git add -A
        git commit -m "Auto: Daily predictions $(date '+%Y-%m-%d %H:%M')" || echo "No changes to commit"
        git push
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    
    - name: Upload logs
      if: failure()
      uses: actions/upload-artifact@v3
      with:
        name: execution-logs
        path: logs/
